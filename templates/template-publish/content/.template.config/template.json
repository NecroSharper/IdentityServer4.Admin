{
  "$schema": "http://json.schemastore.org/template",
  "author": "NecroSharper",
  "classifications": [
    "Web",
    "IdentityServer10",
    "Admin"
  ],
  "name": "NecroSharper IdentityServer10 Admin",
  "identity": "NecroSharper.IdentityServer10.Admin",
  "groupIdentity": "NecroSharper.IdentityServer10.Admin",
  "shortName": "necrosharper.is10admin",
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "sourceName": "NecroSharperIdentityServer10Admin",
  "preferNameDirectory": true,
  "symbols": {
    "title": {
      "type": "parameter",
      "defaultValue": "NecroSharper IdentityServer10 Admin",
      "replaces": "NecroSharper IdentityServer10 Admin",
      "isRequired": true,
      "description": "The title and footer of the Admin UI"
    },
    "adminpassword": {
      "type": "parameter",
      "defaultValue": "Pa$$word123",
      "replaces": "Pa$$word123",
      "isRequired": true,
      "description": "The admin password, that is used to first login (default is Pa$$word123)."
    },
    "adminemail": {
      "type": "parameter",
      "defaultValue": "admin@necrosharper.com",
      "replaces": "admin@necrosharper.com",
      "isRequired": true,
      "description": "The admin email."
    },
    "adminrole": {
      "type": "parameter",
      "defaultValue": "NecroSharperIdentityAdminAdministrator",
      "replaces": "NecroSharperIdentityAdminAdministrator",
      "isRequired": true,
      "description": "The name of admin role, that is used to authorize the administration (for example: MyAdminRole)."
    },
    "adminclientid": {
      "type": "parameter",
      "defaultValue": "necrosharper_identity_admin",
      "replaces": "necrosharper_identity_admin",
      "isRequired": true,
      "description": "The name of client, that is used in the IdentityServer10"
    },
    "adminclientsecret": {
      "type": "parameter",
      "defaultValue": "necrosharper_admin_client_secret",
      "replaces": "necrosharper_admin_client_secret",
      "isRequired": true,
      "description": "The value of client secret, that is used in the IdentityServer10"
    },
    "dockersupport": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "isRequired": true,
      "description": "Add docker support for Admin UI"
    }
  },
  "sources": [
    {
      "modifiers": [
        {
          "condition": "(!dockersupport)",
          "exclude": [
            "shared/**",
            "docker-compose.dcproj",
            ".dockerignore",
            "docker-compose.yml",
            "docker-compose.override.yml",
            "docker-compose.vs.debug.yml",
            "docker-compose.vs.release.yml",
            "src/NecroSharperIdentityServer10Admin.Admin/Dockerfile",
            "src/NecroSharperIdentityServer10Admin.Admin.Api/Dockerfile",
            "src/NecroSharperIdentityServer10Admin.STS.Identity/Dockerfile",
            "NecroSharperIdentityServer10Admin.AdminUI.sln"            
          ]
        },
        {
          "condition": "(dockersupport)",
          "exclude": [
            "NecroSharperIdentityServer10Admin.Admin.sln"
          ]
        }
      ]
    }
  ],
  "primaryOutputs": [
    {
      "path": "src/NecroSharperIdentityServer10Admin.Admin/NecroSharperIdentityServer10Admin.Admin.csproj"
    },
    {
      "path": "src/NecroSharperIdentityServer10Admin.STS.Identity/NecroSharperIdentityServer10Admin.STS.Identity.csproj"
    },
    {
      "path": "src/NecroSharperIdentityServer10Admin.Admin.Api/NecroSharperIdentityServer10Admin.Admin.Api.csproj"
    },
    {
      "path": "src/NecroSharperIdentityServer10Admin.Admin.EntityFramework.Shared/NecroSharperIdentityServer10Admin.Admin.EntityFramework.Shared.csproj"
    },
    {
      "path": "src/NecroSharperIdentityServer10Admin.Admin.EntityFramework.MySql/NecroSharperIdentityServer10Admin.Admin.EntityFramework.MySql.csproj"
    },
    {
      "path": "src/NecroSharperIdentityServer10Admin.Admin.EntityFramework.PostgreSQL/NecroSharperIdentityServer10Admin.Admin.EntityFramework.PostgreSQL.csproj"
    },
    {
      "path": "src/NecroSharperIdentityServer10Admin.Admin.EntityFramework.SqlServer/NecroSharperIdentityServer10Admin.Admin.EntityFramework.SqlServer.csproj"
    },
    {
      "path": "src/NecroSharperIdentityServer10Admin.Shared/NecroSharperIdentityServer10Admin.Shared.csproj"
    }
  ],
  "postActions": [
    {
      "actionId": "D396686C-DE0E-4DE6-906D-291CD29FC5DE",
      "args": {
        "primaryOutputIndexes": "0;1;2;3;4;5;6;7"
      },
      "continueOnError": false,
      "manualInstructions": [
        {
          "text": "Add projects to solution."
        }
      ]
    },
    {
      "description": "Restore NuGet packages required by this project.",
      "manualInstructions": [
        {
          "text": "Run 'dotnet restore'"
        }
      ],
      "actionId": "210D431B-A78B-4D2F-B762-4ED3E3EA9025",
      "continueOnError": true
    }
  ]
}